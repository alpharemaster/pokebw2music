	alloc_tracks 0x0003
	open_track 0, Track_0
	open_track 1, Track_1
Track_0:
	random pan 40, 88
	note_wait 1
	program 0
	random volume 84, 127
	bend_range 2
	random pitch_bend 0, 127
	note C4, 127, 0
	random wait 30, 60
	jump Track_0
	end
Track_1:
	random pan 32, 96
	note_wait 1
	program 0
	random volume 84, 127
	bend_range 2
	random pitch_bend -127, -10
	note A3, 127, 0
	random wait 20, 60
	jump Track_1
	end
	end
