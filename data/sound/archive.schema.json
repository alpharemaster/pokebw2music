{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "The sound archive's players, streams and groups: data/sound/archive.json",
    "description": "The parts of the sound archive (swan_sound_data.sdat) besides its sequences, banks and wave archives, which tools/data/sound_data.py packs from data/sound/. Each list is in number order.",
    "type": "object",
    "additionalProperties": false,
    "required": [ "players", "stream_players", "streams", "groups" ],
    "properties": {
        "$schema": { "type": "string", "description": "This schema, for editors" },
        "players": {
            "type": "array",
            "description": "The sequence players, which sequences name by their player",
            "items": {
                "type": "object", "additionalProperties": false,
                "required": [ "name", "max_sequences", "channels", "heap_size" ],
                "properties": {
                    "name": { "type": "string", "pattern": "^PLAYER_" },
                    "max_sequences": { "type": "integer", "minimum": 0, "maximum": 255, "description": "How many sequences can play on it at once" },
                    "channels": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 15 }, "description": "The sound channels its notes may use" },
                    "heap_size": { "type": "integer", "minimum": 0, "description": "The bytes of a heap of its own, which it loads its sequences into, or 0 for none" }
                }
            }
        },
        "stream_players": {
            "type": "array",
            "items": {
                "type": "object", "additionalProperties": false, "required": [ "name", "channels" ],
                "properties": {
                    "name": { "type": "string", "pattern": "^PLAYER_" },
                    "channels": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 15 }, "maxItems": 16 }
                }
            }
        },
        "streams": {
            "type": "array",
            "description": "The streams, each with its file data/sound/streams/<name>.strm",
            "items": {
                "type": "object", "additionalProperties": false, "required": [ "name", "volume", "player_priority", "player" ],
                "properties": {
                    "name": { "type": "string", "pattern": "^STRM_" },
                    "volume": { "type": "integer", "minimum": 0, "maximum": 127 },
                    "player_priority": { "type": "integer", "minimum": 0, "maximum": 127 },
                    "player": { "type": "string", "pattern": "^PLAYER_", "description": "A stream player" }
                }
            }
        },
        "groups": {
            "type": "array",
            "description": "Groups of sequences, banks and wave archives that the game loads together",
            "items": {
                "type": "object", "additionalProperties": false, "required": [ "name", "items" ],
                "properties": {
                    "name": { "type": "string", "pattern": "^GROUP_" },
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "object", "additionalProperties": false, "required": [ "name", "load" ],
                            "properties": {
                                "name": { "type": "string", "pattern": "^(SEQ|BANK|WAVE)_", "description": "A sequence, bank or wave archive" },
                                "load": {
                                    "type": "array",
                                    "items": { "enum": [ "sequence", "bank", "wave_archive", "single_waves" ] },
                                    "description": "What of it to load: a sequence's data, its bank, the bank's wave archives"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
